# ---- Backend ----
DATABASE_URL=postgresql+psycopg2://ittracker:ittracker@localhost:5432/ittracker
# Set to 0 to start with an empty database. With 1 (default) an empty database gets a sample factory
# owned by the demo login demo@ittracker.local / demo1234.
SEED_SAMPLE=1
# Signs the login cookie. Set a long random string in production (logins are invalidated when it changes).
SECRET_KEY=change-me
# 1 = only send the login cookie over HTTPS
COOKIE_SECURE=0
# Optional script credential: requests carrying `X-Access-Key: <value>` are treated as an owner of every company.
APP_ACCESS_KEY=
# Dev frontend origin(s) allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173
# 0 = don't run the hourly reminder scheduler in this process (tests, one-off scripts)
SCHEDULER=1
LOG_LEVEL=INFO

# ---- Reminders: WhatsApp via Meta Cloud API (all three optional; unset = reminders logged as skipped_not_configured) ----
WA_PHONE_NUMBER_ID=
WA_TOKEN=
# Approved template name; leave empty to send plain text messages (works only inside a 24h customer window — POC)
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=en
WA_API_VERSION=v20.0

# ---- Reminders: email via SMTP (SMTP_HOST unset = skipped_not_configured) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
