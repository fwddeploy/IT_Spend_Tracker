# Backend
DATABASE_URL=postgresql+psycopg2://ittracker:ittracker@localhost:5432/ittracker
# set to 0 to start with an empty database (no sample company)
SEED_SAMPLE=1
# Optional: if set, every API call must send this value in the X-Access-Key header (the web page asks for it once)
APP_ACCESS_KEY=
# Dev frontend origin(s) allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173
